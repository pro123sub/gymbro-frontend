# ==============================================================================
# GYMFLOW Next.js Admin Panel - Example Environment Template
# Copy to .env or .env.local (or set in Vercel -> Project Settings -> Env Vars)
# ==============================================================================

# FastAPI Backend Base URL (local or deployed Railway backend)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Enterprise Studio Tenant & Auth Headers sent to FastAPI
NEXT_PUBLIC_TENANT_ID=crush-main-studio
NEXT_PUBLIC_API_KEY=

# Studio Display & Live n8n / Google Sheets Links
NEXT_PUBLIC_STUDIO_NAME=Crush Lifestyle Fitness Studio
NEXT_PUBLIC_N8N_BASE_URL=https://your-n8n-instance.up.railway.app
NEXT_PUBLIC_GOOGLE_SHEET_ID=REPLACE_WITH_GOOGLE_SHEET_ID

# Server-Side OpenAI Copilot Integration (used in Next.js /api/ai-copilot route)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
